# ---- データソース ----
# mock   : メモリ上のデモデータ (認証情報不要・再起動で初期化)
# sheets : Google スプレッドシート
DATA_SOURCE=mock

# ---- 管理画面 Basic 認証 (本番では必須。未設定だと本番は 503) ----
ADMIN_USER=admin
ADMIN_PASSWORD=

# LINE メッセージ内のポータルURLに使う公開URL
APP_BASE_URL=http://localhost:3000

# ドライバー画面「管理者に電話する」ボタンの番号
ADMIN_PHONE=

# ---- Google (DATA_SOURCE=sheets の場合) ----
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# JSON キーの private_key を 1 行で (改行は \n のまま)
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SHEETS_ID=
# 書類画像の保存先。共有ドライブ内のフォルダID (サービスアカウントを「コンテンツ管理者」で追加)
GOOGLE_DRIVE_FOLDER_ID=

# ---- Gemini OCR (未設定時はデモ値を返す) ----
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- LINE Messaging API (管理画面からの手動送信用。未設定時はログ出力のみ) ----
LINE_CHANNEL_ACCESS_TOKEN=
